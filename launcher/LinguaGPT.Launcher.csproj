<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LinguaGPT.Launcher</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\logo\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\logo\linguagpt.ico" Link="Assets\linguagpt.ico" />
  </ItemGroup>
</Project>
